{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projects.schema.json",
  "title": "Oganes Office project database",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "typetag",
      "visibility",
      "youtube",
      "shots",
      "description"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "typetag": {
        "type": "string",
        "minLength": 1
      },
      "visibility": {
        "enum": ["hidden", "shown", "flagman"]
      },
      "youtube": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://([^/]+\\.)?(youtube\\.com|youtube-nocookie\\.com)/|^https://youtu\\.be/"
      },
      "shots": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "thumbnail"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "thumbnail": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
